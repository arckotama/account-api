# Database (dipakai oleh PostgreSQL dan aplikasi Go)
DB_USER=account_user
DB_PASSWORD=account_pass
DB_NAME=account_db

# Port yang dibuka di sisi WSL2/Windows
DB_PORT=5432
APP_PORT=8080

# ID user WSL2 kamu, supaya file yang dibuat container tidak memiliki root
# Cek dengan: id -u dan id -g
HOST_UID=1000
HOST_GID=1000